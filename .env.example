# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/fake-call-app
# Or for MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/fake-call-app

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=7d

# SIP Configuration
SIP_SERVER=sip.provider.com
SIP_PORT=5060
SIP_DOMAIN=provider.com
SIP_DISPLAY_NAME=FakeCall App
SIP_STUN_SERVER=stun.l.google.com:19302
SIP_TURN_SERVER=turn.provider.com
SIP_TURN_USERNAME=username
SIP_TURN_PASSWORD=password

# Redis (for job queue and caching)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Push Notifications
FCM_SERVER_KEY=your-firebase-server-key
APNS_KEY_ID=your-apns-key-id
APNS_TEAM_ID=your-apns-team-id
APNS_BUNDLE_ID=com.example.fakecall

# Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@fakecall.com

# Storage
STORAGE_TYPE=local
# STORAGE_TYPE=s3
AWS_S3_BUCKET=fake-call-recordings
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
CORS_ORIGIN=http://localhost:3000

# App Configuration
MAX_CALL_DURATION=3600
MAX_RECORDING_SIZE=104857600
AUTO_DELETE_RECORDINGS_DAYS=30

# External APIs
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
